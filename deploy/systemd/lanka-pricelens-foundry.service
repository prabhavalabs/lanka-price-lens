[Unit]
Description=Lanka PriceLens source sync and PDF processing workflows
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/lanka-price-lens
EnvironmentFile=/etc/lanka-price-lens/app.env
EnvironmentFile=/etc/lanka-price-lens/release.env
Nice=10
ExecStart=/usr/bin/flock -n /run/lock/lanka-price-lens.lock /usr/bin/docker compose --profile tools run --rm --no-deps foundry sync
