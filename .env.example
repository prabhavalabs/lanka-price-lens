APP_BIND=127.0.0.1
APP_PORT=
ADMIN_EMAIL=admin@lankapricelens.com
ADMIN_PASSWORD_HASH=
LPL_SOURCE_MANIFEST_PATH=../data/manifests/harti_daily_food_prices.json
LPL_MAPPING_BUNDLE_PATH=../data/mappings/harti_daily_food_prices.json
LPL_MANIFESTS_DIR=../data/manifests
LPL_MAPPINGS_DIR=../data/mappings
LPL_RECIPES_DIR=../data/recipes
POSTGRES_PASSWORD=
LPL_POSTGRES_URL=postgres://pricelens:change-me@127.0.0.1:5432/pricelens
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
LPL_R2_BUCKET=lanka-price-lens-pdfs
LPL_ARCHIVE_DRIVER=cloudflare
LPL_LOCAL_ARCHIVE_ROOT=../data/raw/archive
LPL_ENVIRONMENT=local
LPL_SCHEDULER_ENABLED=true
LPL_SCHEDULER_INTERVAL_MS=15000

# Host names the API serves each site on (comma separated). The public price site answers on LPL_WEB_HOSTS,
# the owner's admin on LPL_ADMIN_HOSTS; leave both empty on a single-host install (public site at /, admin at /admin/).
LPL_ADMIN_HOSTS=admin.badumila.com,admin.price.prabhavalabs.com,lanka-price-lens.prabhavalabs.com
LPL_WEB_HOSTS=badumila.com,www.badumila.com,price.prabhavalabs.com

# Keells' bot protection refuses the server's own network; its captures go through this HTTP proxy
# (http://user:password@host:port). Named by the manifest's adapter setting proxyEnv; leave empty to go direct.
LPL_KEELLS_PROXY_URL=

# Public site analytics: a Google Analytics 4 measurement id (G-XXXXXXXXXX). Empty disables analytics.
LPL_GA_MEASUREMENT_ID=
# The community Discord invite (https://discord.gg/…). The site links to it and, after a while, invites visitors once.
LPL_DISCORD_INVITE_URL=

# Feedback and bug reports from the public site are forwarded by mail through Resend (https://resend.com)
# when both the key and the address are set. LPL_MAIL_FROM must be a sender Resend accepts: a verified
# domain of yours, or the shared test sender onboarding@resend.dev (the default) while testing.
LPL_FEEDBACK_EMAIL_TO=
# Discord incoming webhook (the community server's staff inbox); each feedback message is posted there too.
LPL_FEEDBACK_DISCORD_WEBHOOK=
LPL_RESEND_API_KEY=
LPL_MAIL_FROM=

# Notifications (price alerts and digests through the notify package). Telegram: the bot token from BotFather
# and, for the daily broadcast, a public channel the bot administers (@handle or -100… id). Web Push: a VAPID key
# pair made once with `pnpm foundry notify vapid` and a subject (mailto: or the site URL) push services may contact.
LPL_TELEGRAM_BOT_TOKEN=
LPL_TELEGRAM_CHANNEL=
LPL_VAPID_PUBLIC_KEY=
LPL_VAPID_PRIVATE_KEY=
LPL_VAPID_SUBJECT=mailto:you@example.com

# The distribution channels (docs/distribution.md): the id and secret of your own Meta app. One app
# serves both the Facebook Page and the Instagram account linked to it. The accounts themselves are
# connected from the admin, and every access token is kept sealed under LPL_ACCOUNT_STATE_SECRET.
LPL_FACEBOOK_APP_ID=
LPL_FACEBOOK_APP_SECRET=
# Where the content library keeps its pictures. Defaults to a "content" folder beside the database,
# which inside the container is the data volume. They are served publicly at /content/<name>.jpg,
# because Facebook and Instagram fetch a picture themselves from the address a post names.
LPL_CONTENT_DIR=

# Accounts on the public site. Account mail (verification, resets) goes through the Resend key above,
# from LPL_MAIL_FROM on a domain verified in Resend (docs/accounts.md). Google sign-in needs an OAuth web
# client whose redirect URI is <site origin>/v1/auth/google/callback. LPL_SITE_ORIGIN is where links in
# mail point; the state secret signs the sign-in handshake cookie (any long random string).
LPL_SITE_ORIGIN=https://badumila.com
LPL_GOOGLE_CLIENT_ID=
LPL_GOOGLE_CLIENT_SECRET=
LPL_ACCOUNT_STATE_SECRET=

# Daily mails (docs/newsletters.md): the recipe mail and the deals mail run inside the API once a day at
# LPL_NEWSLETTER_HOUR (Colombo time) for accounts that switched them on; off unless enabled.
LPL_NEWSLETTERS_ENABLED=false
LPL_NEWSLETTER_HOUR=07:30

# The MCP server (docs/mcp.md) is configured where the agent runs, not here; these are its names.
# LPL_MCP_TOKEN=      a token made in the admin under Distribution Channels, Agent access
# LPL_MCP_ORIGIN=     the admin's address; defaults to https://badumila.com's admin host
# LPL_MCP_WRITE=1     allow changes; left out, the server reads but changes nothing
